[Unit]
Description=VintageContacts Express and SQLite service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/vintagecontacts
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Environment=DB_PATH=/var/lib/vintagecontacts/contacts.sqlite
Environment=SEED_DEMO=true
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
